# Loaded by `next dev` and the Prisma CLI (see prisma.config.ts), never by production builds
# To use different values on your machine (e.g. another port), set them in .env.local (this takes priority)

POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/trc"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/trc