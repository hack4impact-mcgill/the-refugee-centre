// Learn more about the Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Volunteer {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  name           String?
  phone          String?
  email          String?             @unique
  approvedShifts Int?                @default(0) @map("approved_shifts")
  refusedShifts  Int?                @default(0) @map("refused_shifts")
  languages      VolunteerLanguage[]

  @@map("volunteers")
}

model Language {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  language   String              @unique
  volunteers VolunteerLanguage[]

  @@map("languages")
}

model VolunteerLanguage {
  volunteerId String    @map("volunteer_id") @db.Uuid
  languageId  String    @map("language_id") @db.Uuid
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  language    Language  @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([volunteerId, languageId])
  @@map("volunteer_languages")
}

model Position {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  name        String
  description String?

  @@map("positions")
}
